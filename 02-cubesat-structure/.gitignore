# Project 02 -- large or regenerable artifacts.
# Reproducibility comes from the tracked scripts, geometry (STEP/BRep of
# the clean Config A solid) and results JSON/CSV, not from committing
# meshes, solver output or solver input files.

# CalculiX input files: 1.7-15 MB each, fully regenerated by
#   scripts/mesh_config_a.py <maxh>, scripts/make_roller_bc_case.py,
#   scripts/mesh_and_solve_2a_panel.py, scripts/mesh_and_solve_2b_rail.py
simulation/*.inp

# Viewing-only surface mesh, regenerated by scripts/view_config_a_mesh.py
mesh/config_a_study/*.stl

# Kept locally as a record of the stray-face defect; not part of the pipeline
mesh/config_a_study/config_a_base_frame_DEFECTIVE.brep
mesh/config_a_study/config_a_clean_netgen_written.step

# Configuration B geometry candidates: regenerated by
#   scripts/build_config_b_panels.py (design not yet adopted for the study)
mesh/config_b_study/*.brep
# Configuration B random-shape exploration: 223 candidates generated,
# only 5 (the winners) and the isolated-panel design kept individually.
# Regenerable via scripts/build_config_b_random.py (seed=2) and
# scripts/build_config_b_random_assembly.py --all.
mesh/config_b_study/config_b_random_attempt*.brep
mesh/config_b_study/config_b_random_assembly_attempt*.brep
mesh/config_b_study/config_b_random_assembly_attempt*.step
!mesh/config_b_study/config_b_random_assembly_attempt16_hull.brep
!mesh/config_b_study/config_b_random_assembly_attempt16_hull.step
!mesh/config_b_study/config_b_random_assembly_attempt37_hull.brep
!mesh/config_b_study/config_b_random_assembly_attempt37_hull.step
!mesh/config_b_study/config_b_random_assembly_attempt54_hull.brep
!mesh/config_b_study/config_b_random_assembly_attempt54_hull.step
!mesh/config_b_study/config_b_random_assembly_attempt15_hull.brep
!mesh/config_b_study/config_b_random_assembly_attempt15_hull.step
!mesh/config_b_study/config_b_random_assembly_attempt40_hull.brep
!mesh/config_b_study/config_b_random_assembly_attempt40_hull.step

# Verbose Gmsh/mesh-generation logs -- not part of the reproducibility chain
mesh/config_b_study/*.log
results/config_b_meshlog/*.log
