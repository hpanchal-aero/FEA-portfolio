# Project 03 -- large or regenerable artifacts.
# Reproducibility comes from the tracked scripts and geometry (STEP/BRep),
# not from committing meshes, solver output, or solver input files.

# CalculiX input files: regenerated by scripts/mesh_stage1_spar.py <maxh>
simulation/*.inp

# Solver scratch/output -- regenerable by re-running the solve
simulation/*.frd
simulation/*.dat
simulation/*.sta
simulation/*.cvg
simulation/*.12d
simulation/*.ccx.log
spooles.out

# Python cache
scripts/__pycache__/

# Stage 2 additions: visualization fields and preview geometry (regenerable)
simulation/*.vtu
mesh/stage2_ribs/*PREVIEW*

# Stage 3 additions: regenerable intermediates (rebuilt by scripts/build_stage3_skin_geom.py,
# scripts/mesh_stage3_skin_raw.py, scripts/build_stage3_skin_inp.py from the tracked STEP files)
simulation/*.nam
mesh/stage3_skin/*.npz
mesh/stage3_skin/*.msz
mesh/stage3_skin/stage3_skin_geom.step
mesh/stage3_skin/stage3_skin_geom.brep

# regenerable rib-spacing study geometry (RIB_SPACING != 200): rebuild with the scripts, see development-log
mesh/stage3_solid/*_rs*
mesh/stage3_skin/*_rs*
mesh/stage3_solid/*_L*
mesh/stage3_solid/*_rt*
mesh/stage3_skin/*_L*
mesh/stage3_skin/*_rt*
results/stage6/logs/
results/stage6/live.log
results/stage6/driver.log
results/stage6/driver.lock
results/stage6/*.out
results/stage6/*_stdout*.log
results/stage6/render_cases/
*.bak_skin
*.bak_stress
*.bak_stage6
*.bak_status6
results/stage6_results.csv.pre_skin
results/stage4_s*_k8_L*_results.json
figures/3d/*.glb
*.bak_hash
*.bak_mesh
*.bak_conv2
figures/3d/L006_buckling_mode1.png
figures/3d/L006_buckling_mode1_zoom.png
