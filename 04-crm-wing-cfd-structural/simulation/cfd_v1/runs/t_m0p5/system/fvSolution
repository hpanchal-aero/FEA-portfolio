FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
        maxIter         100;
    }
}

PIMPLE
{
    residualControl
    {
        p               1e-6;
        U               1e-5;
        h               1e-5;
    }
    nNonOrthogonalCorrectors 1;
    transonic       yes;
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             0.01;
    }
    equations
    {
        U               0.7;
        h               0.7;
    }
}
